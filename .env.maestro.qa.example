# Copy to `.env.maestro.qa` (gitignored). Never commit secrets.
# Run ONLY via: bash scripts/maestro-test-qa.sh …
# That entrypoint sets MAESTRO_ENV_LANE=qa and MAESTRO_ENV_FILE=.env.maestro.qa.
# Do not use `.env.maestro` (Dev) for QA. The runner pins and refuses any other
# EXPO_PUBLIC_API_BASE_URL (including Maestro -e/--env) before adb/Maestro.
#
# Seeded QA user emails (identities only — do not store passwords here):
#   qa+fluentqa-translator@fluent.local   Account A (assignments)
#   qa+fluentqa-translator2@fluent.local  second translator
#   qa+fluentqa-pm@fluent.local            PM seed authority (not Account B)
#   qa+fluentqa-observer@fluent.local      Account B if preflight shows no assignments
#   qa+fluentqa-om@fluent.local            third account for the cap UI
#   qa+fluentqa-sa@fluent.local            spare / role visibility
#
# Passwords: secure user entry / CI secret injection only. Leave *_PASSWORD
# blank in this template and in local copies when possible; never recommend
# persisting passwords in env files.
#
# Mutating lanes require an allowlisted disposable project id.
# Put demo project ids in the denylist. The guard refuses those ids
# even if they are also allowlisted. Do not seed or reset demo projects.

# Immutable QA API (must match scripts/maestro-env-guard.cjs).
EXPO_PUBLIC_API_BASE_URL=https://qa.api.fluent.bible

MAESTRO_EMAIL=qa+fluentqa-translator@fluent.local
MAESTRO_PASSWORD=

MAESTRO_TRANSLATOR2_EMAIL=qa+fluentqa-translator2@fluent.local
MAESTRO_TRANSLATOR2_PASSWORD=

MAESTRO_PM_EMAIL=qa+fluentqa-pm@fluent.local
MAESTRO_PM_PASSWORD=

MAESTRO_EMAIL_2=qa+fluentqa-observer@fluent.local
MAESTRO_PASSWORD_2=

MAESTRO_EMAIL_3=qa+fluentqa-om@fluent.local
MAESTRO_PASSWORD_3=

MAESTRO_FIXTURE_PROJECT_ALLOWLIST=
MAESTRO_FIXTURE_PROJECT_DENYLIST=
MAESTRO_FIXTURE_PROJECT_ID=
MAESTRO_FIXTURE_CHAPTER_ID=

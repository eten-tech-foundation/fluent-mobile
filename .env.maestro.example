# Copy to `.env.maestro` (gitignored via `.env.*`). Never commit real credentials.
#
# Two dedicated QA accounts on the Fluent API (see docs/guides/maestro.md):
#   Account A — translator shape (≥1 chapter assignment) → primary smokes
#   Account B — member-without-assignments (project membership, no assignee rows)
#               → empty-assignments + multi-account isolation
#
# Seed: both on the same QA project (e.g. Source Audio QA, BSB). Prefer distinct
# My Work labels when Account B ever gains assignments (isolation asserts).
#
# `scripts/maestro-test.sh` loads this file literally (no Bash expansion) when present.
# Role aliases below are optional; if set, they fill MAESTRO_EMAIL(_2) when those are empty.
# Or: `maestro test -e MAESTRO_EMAIL=... -e MAESTRO_PASSWORD=... .maestro/...`

# --- Account A: translator shape (canonical names used by flows / EAS secrets) ---
MAESTRO_EMAIL=
MAESTRO_PASSWORD=

# --- Account B / second translator ---
# Empty-assignments + multi-account: member-without-assignments on the QA project.
# Ownership fixtures (#607): must be a Project Translator on the disposable
# fixture project (open Peer Check submit + "other" drafter). Do not reuse
# MAESTRO_PM_EMAIL here - the PM cannot submit a draft chapter.
MAESTRO_EMAIL_2=
MAESTRO_PASSWORD_2=

# Optional aliases (same values as above — clearer local naming)
# MAESTRO_TRANSLATOR_EMAIL=
# MAESTRO_TRANSLATOR_PASSWORD=
# For ownership fixtures (#574), MAESTRO_PM_* must be a Project Manager on the
# disposable fixture project (PATCH assign-selected). May differ from Account B.
# MAESTRO_PM_EMAIL=
# MAESTRO_PM_PASSWORD=

# API the Debug APK / Metro session should hit (must match your .env / Metro env).
EXPO_PUBLIC_API_BASE_URL=https://dev.api.fluent.bible

# Local Debug + Metro only — suppresses Expo Dev Menu so it does not steal taps.
# Do NOT set on production / preview / nightly EAS profiles.
# EXPO_PUBLIC_E2E_MODE=1

# Optional transfer holds (default off). Inert unless Debug (__DEV__) +
# EXPO_PUBLIC_E2E_MODE + EXPO_PUBLIC_API_BASE_URL=https://qa.api.fluent.bible.
# Upload hold: upload orchestrator never starts, so saved takes stay queued
# (Sync-page upload controls report "not started"); metadata sync still runs.
# EXPO_PUBLIC_E2E_HOLD_UPLOADS=1
# Download hold: queued offline downloads do not auto-resume after login/restore.
# EXPO_PUBLIC_E2E_HOLD_DOWNLOAD_AUTO_RESUME=1

# Launch mode: metro (default, Debug deep-link) | embedded (e2e-test / nightly APK)
# MAESTRO_LAUNCH_MODE=metro
# Optional override of the Dev Client deep-link (emulator → host via 10.0.2.2).
# Metro must listen on all interfaces (npm run maestro:metro — not --localhost).
# MAESTRO_DEV_CLIENT_URL=exp+fluent-mobile://expo-development-client/?url=http%3A%2F%2F10.0.2.2%3A8081%3FdisableOnboarding%3D1&disableFab=1&disableAutoLaunch=1

# --- Ownership / claim disposable fixtures (#574) ---
# Prefer a dedicated Fluent project the PM owns (never shared QA).
# Example baseline on "Source Audio QA — BSB" (project 432):
#   mine=Mark 1, other=Mark 9, unassigned=Mark 4, claim=Mark 7 (not_started)
# Seed/reset via API (no browser required for assign/clear):
#   npm run maestro:fixtures:seed
#   npm run maestro:fixtures:verify
# Suite: npm run maestro:test:ownership
MAESTRO_FIXTURE_PROJECT_NAME=
MAESTRO_FIXTURE_PROJECT_ID=
MAESTRO_FIXTURE_MINE_LABEL=
MAESTRO_FIXTURE_OTHER_LABEL=
MAESTRO_FIXTURE_UNASSIGNED_LABEL=
# Single-book gallery: section title "Chapter N" is not a descendant Maestro
# can scope. ownership-states and taken-warning pin these assignment ids.
MAESTRO_FIXTURE_MINE_CHAPTER_ID=
MAESTRO_FIXTURE_OTHER_CHAPTER_ID=
MAESTRO_FIXTURE_UNASSIGNED_CHAPTER_ID=
# Disposable not_started chapter for online auto-claim.
# Seed restores via PATCH .../reset-selected (fluent-api #464); 404 rotates locally.
MAESTRO_FIXTURE_CLAIM_LABEL=
# Assignment id for the disposable auto-claim chapter. Single-book galleries
# pin the row; the section title "Chapter N" is not a scoped descendant.
MAESTRO_FIXTURE_CLAIM_CHAPTER_ID=
# Real audio-take conflict (three uploads; third uses a stale baseVersionToken)
MAESTRO_FIXTURE_CONFLICT_LABEL=
MAESTRO_FIXTURE_CONFLICT_CHAPTER_ID=
# Open Peer Check: MAESTRO_EMAIL_2 as drafter, then that account submits
MAESTRO_FIXTURE_OPEN_PEER_CHECK_LABEL=
MAESTRO_FIXTURE_OPEN_PEER_CHECK_CHAPTER_ID=
# Book-page section title of a review-stage chapter on the fixture project.
# Observer opens observer-screen only for community_review and later checks.
# Pin the row by milestone (project unit) id and chapter assignment id.
MAESTRO_FIXTURE_OBSERVER_LABEL=
MAESTRO_FIXTURE_OBSERVER_MILESTONE_ID=
MAESTRO_FIXTURE_OBSERVER_CHAPTER_ID=
# Optional override if the project has multiple other translators:
# MAESTRO_FIXTURE_OTHER_USER_ID=

# --- Pinned chapter / verse (existing-session + mutating) ---
# Home Next-up / Changes requested id. Missing interpolates as "undefined"
# on Maestro 2.10 — leave blank to fail preflight (Blocked), never skip-green.
MAESTRO_FIXTURE_CHAPTER_ID=
MAESTRO_FIXTURE_CHAPTER_LABEL=
# Complete-stage chapter for complete-idle-lock. Not the draft chapter id.
MAESTRO_FIXTURE_COMPLETE_CHAPTER_ID=
MAESTRO_FIXTURE_MILESTONE_ID=
MAESTRO_FIXTURE_VERSE_NUMBER=
MAESTRO_EXPECT_RECORD_REFERENCE=
MAESTRO_FIXTURE_TAKE_VIEW_ALL_MARKER=
MAESTRO_FIXTURE_VERSE_REF_FIRST=
MAESTRO_FIXTURE_VERSE_REF_NEXT=

# --- Resources / ownership / sync existing-session ---
MAESTRO_EXPECT_RESOURCES_EMPTY_FIXTURE=
MAESTRO_EXPECT_RESOURCES_EMPTY_KIND=
MAESTRO_EXPECT_RESOURCES_POPULATED_FIXTURE=
MAESTRO_EXPECT_RESOURCES_POPULATED_SECTION=
MAESTRO_EXPECT_RESOURCES_CONTENT_MARKER=
MAESTRO_EXPECT_OWNERSHIP=
MAESTRO_EXPECT_RECORD_WARNING=
MAESTRO_EXPECT_SYNC_STATUS_TITLE=
MAESTRO_EXPECT_SYNC_CONTROLS=
MAESTRO_EXPECT_UPLOAD_CHAPTER_COUNT_TEXT=
MAESTRO_EXPECT_SYNC_ERROR=
MAESTRO_EXPECT_DOWNLOADS=
MAESTRO_EXPECT_EXPO_DEV_MENU_ABSENT=

# Prepare for Offline book row (pfo-download-button-persist).
MAESTRO_PFO_BOOK_NAME=

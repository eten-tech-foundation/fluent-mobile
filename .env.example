# Local emulator (host machine localhost:9999)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:9999

# EAS preview / nightly builds use https://qa.api.fluent.bible (eas.json profiles
# "preview" and "nightly"). Matching web: https://qa.app.fluent.bible/
# Local / Path A engineering still uses localhost or https://dev.api.fluent.bible.
#
# Do NOT add Azure / R2 storage secrets here — they are server-side only
# (fluent-api). See docs/guides/recordings-sync-contract.md.

# Next UI component gallery (fluent://gallery). On for development / preview /
# nightly EAS profiles; never set in production. See docs/guides/figma-to-component.md.
# EXPO_PUBLIC_COMPONENT_GALLERY=true
